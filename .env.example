# ==========================================
# ELD WORKSPACE - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase
# ==========================================

# URL da API do projeto no Supabase (ex: https://seu-id.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Anon Key pública do Supabase (Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica-aqui
